##
##  /etc/nginx/sites-available/jagstream.conf
##

# ──────────────  CORS ORIGIN MAP  ────────────────
map $http_origin $cors_origin {
    default                                     "";
    "http://localhost:5173"                     $http_origin;   # Vite dev
    "https://jagstream.yuvrajsoneja.in"         $http_origin;   # Front-end
    "https://jagstreamserver.yuvrajsoneja.in"   $http_origin;   # API
}

# ──────────────  API  (jagstreamserver.*)  ────────────────
server {
    listen       443 ssl http2;
    server_name  jagstreamserver.yuvrajsoneja.in;

    ssl_certificate     /etc/letsencrypt/live/jagstreamserver.yuvrajsoneja.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jagstreamserver.yuvrajsoneja.in/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 2G;

    location / {
        proxy_pass         http://localhost:3005;
        proxy_http_version 1.1;

        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";

        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   Origin              $http_origin;

        # ─── Always add CORS headers ─────────────
        add_header 'Access-Control-Allow-Origin' "$cors_origin" always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type' always;

        # ─── Preflight: OPTIONS ──────────────────
        if ($request_method = OPTIONS) {
            add_header 'Access-Control-Allow-Origin' "$cors_origin" always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type' always;
            add_header 'Content-Length' 0;
            add_header 'Content-Type' 'text/plain; charset=UTF-8';
            return 204;
        }
    }
}

# ────────────── HTTP → HTTPS (API) ────────────────
server {
    listen      80;
    server_name jagstreamserver.yuvrajsoneja.in;
    return 301  https://$host$request_uri;
}

# ────────────── FRONT-END (jagstream.*) ────────────────
server {
    listen       443 ssl http2;
    server_name  jagstream.yuvrajsoneja.in;

    ssl_certificate     /etc/letsencrypt/live/jagstream.yuvrajsoneja.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jagstream.yuvrajsoneja.in/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    root /home/yuvraj/client/dist;
    index  index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ────────────── HTTP → HTTPS (Front-end) ────────────────
server {
    if ($host = jagstream.yuvrajsoneja.in) {
        return 301 https://$host$request_uri;
    }

    listen      80;
    server_name jagstream.yuvrajsoneja.in;
    return 301  https://$host$request_uri;
}
